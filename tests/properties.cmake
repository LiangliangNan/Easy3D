get_property(registered DIRECTORY PROPERTY TESTS)
foreach(name IN LISTS registered)
    set(output "${CMAKE_BINARY_DIR}/tests/artifacts/${name}")
    file(MAKE_DIRECTORY "${output}")
    set_tests_properties(${name} PROPERTIES WORKING_DIRECTORY "${output}")
    get_test_property(${name} LABELS labels)
    if("desktop" IN_LIST labels)
        set_tests_properties(${name} PROPERTIES RUN_SERIAL TRUE)
    endif()
endforeach()
