#version 450
// Ground-truth ambient occlusion from the scene depth buffer. For every pixel
// the view-space position and normal are reconstructed from depth, then a set
// of azimuthal slices searches the horizons of the surrounding depth. The
// visibility of a slice is the cosine-weighted fraction of its two half-planes
// that lies above the horizon, which gives a smooth, accurate AO term without
// a separate geometry pass.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D scene_depth;
layout(set = 0, binding = 1, r32f) uniform image2D ao_result;
layout(set = 0, binding = 4, std140) uniform AoParameters {
    mat4 projection;
    mat4 inverse_projection;
    vec4 shape; // view-space radius, bias, width, height
} ao;

const int SLICE_COUNT = 8;
const int STEP_COUNT = 8;

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// View-space position from a depth sample. The scene vertex shader negates y,
// so the depth image's top row is positive y in the projection's space.
vec3 view_position(vec2 uv, float depth) {
    vec4 p = ao.inverse_projection * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth * 2.0 - 1.0, 1.0);
    return p.xyz / p.w;
}

// Position of a depth neighbor. Background neighbors are reported invalid so
// the normal reconstruction never mixes separate surfaces across a silhouette.
vec3 neighbor_position(vec2 coord, vec3 center, out bool valid) {
    float depth = texture(scene_depth, coord).r;
    valid = depth < 1.0;
    return valid ? view_position(coord, depth) : center;
}

// View-space normal from the closest surviving neighbor on each axis.
vec3 surface_normal(vec2 uv, vec3 center, vec2 texel) {
    bool valid_left, valid_right, valid_up, valid_down;
    vec3 left = neighbor_position(uv - vec2(texel.x, 0.0), center, valid_left);
    vec3 right = neighbor_position(uv + vec2(texel.x, 0.0), center, valid_right);
    vec3 up = neighbor_position(uv - vec2(0.0, texel.y), center, valid_up);
    vec3 down = neighbor_position(uv + vec2(0.0, texel.y), center, valid_down);
    const float far_away = 1e30;
    float left_distance = valid_left ? abs(left.z - center.z) : far_away;
    float right_distance = valid_right ? abs(right.z - center.z) : far_away;
    float up_distance = valid_up ? abs(up.z - center.z) : far_away;
    float down_distance = valid_down ? abs(down.z - center.z) : far_away;
    vec3 dx = left_distance < right_distance ? center - left : right - center;
    vec3 dy = up_distance < down_distance ? up - center : center - down;
    vec3 normal = cross(dx, dy);
    normal = dot(normal, normal) < 1e-20 ? -normalize(center) : normalize(normal);
    return dot(normal, center) > 0.0 ? -normal : normal; // face the camera
}

// Sine of the elevation of an occluder above the tangent plane, or zero when
// the sample cannot occlude the center pixel.
float horizon_sine(vec2 coord, vec3 center, vec3 normal, float radius, float bias) {
    if (any(lessThan(coord, vec2(0.0))) || any(greaterThan(coord, vec2(1.0))))
        return 0.0;
    float depth = texture(scene_depth, coord).r;
    if (depth >= 1.0) // background
        return 0.0;
    vec3 delta = view_position(coord, depth) - center;
    float distance = length(delta);
    if (distance < 1e-5)
        return 0.0;
    float elevation = dot(delta, normal);
    if (elevation <= bias) // behind (or on) the tangent plane
        return 0.0;
    float falloff = clamp(radius / distance, 0.0, 1.0);
    return clamp(elevation / distance, 0.0, 1.0) * falloff;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(ao_result);
    if (any(greaterThanEqual(pixel, extent)))
        return;

    vec2 size = vec2(extent);
    vec2 uv = (vec2(pixel) + 0.5) / size;
    float depth = texture(scene_depth, uv).r;
    if (depth >= 1.0) { // the background is never darkened
        imageStore(ao_result, pixel, vec4(1.0));
        return;
    }

    vec3 center = view_position(uv, depth);
    vec2 texel = 1.0 / size;
    vec3 normal = surface_normal(uv, center, texel);

    vec3 tangent = cross(normal, abs(normal.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0));
    if (dot(tangent, tangent) < 1e-12)
        tangent = cross(normal, vec3(0.0, 0.0, 1.0));
    tangent = normalize(tangent);
    vec3 bitangent = cross(normal, tangent);

    float radius = ao.shape.x;
    float bias = ao.shape.y;
    float jitter = hash12(vec2(pixel));

    vec4 center_clip = ao.projection * vec4(center, 1.0);
    if (center_clip.w <= 0.0) {
        imageStore(ao_result, pixel, vec4(1.0));
        return;
    }
    vec2 center_ndc = center_clip.xy / center_clip.w;
    vec2 center_uv = vec2(center_ndc.x * 0.5 + 0.5, 0.5 - center_ndc.y * 0.5);

    float visibility = 0.0;
    for (int slice = 0; slice < SLICE_COUNT; ++slice) {
        float phi = (float(slice) + jitter) * (6.28318530718 / float(SLICE_COUNT));
        vec3 omega = tangent * cos(phi) + bitangent * sin(phi);

        // Screen-space extent of the half-slice: the radius projected along omega.
        vec4 edge_clip = ao.projection * vec4(center + omega * radius, 1.0);
        if (edge_clip.w <= 0.0)
            continue;
        vec2 edge_ndc = edge_clip.xy / edge_clip.w;
        vec2 edge_uv = vec2(edge_ndc.x * 0.5 + 0.5, 0.5 - edge_ndc.y * 0.5);
        vec2 span = (edge_uv - center_uv) * size;
        float distance = length(span);
        if (distance < 1.0)
            continue;
        vec2 direction = span / distance / size; // uv offset per pixel

        float horizon_positive = 0.0, horizon_negative = 0.0;
        for (int step_index = 0; step_index < STEP_COUNT; ++step_index) {
            float offset = distance * (float(step_index) + 0.5) / float(STEP_COUNT);
            horizon_positive = max(horizon_positive, horizon_sine(uv + direction * offset, center, normal, radius, bias));
            horizon_negative = max(horizon_negative, horizon_sine(uv - direction * offset, center, normal, radius, bias));
        }
        // Cosine-weighted visibility of the two half-planes around the horizon.
        visibility += 1.0 - 0.5 * (horizon_positive * horizon_positive + horizon_negative * horizon_negative);
    }

    imageStore(ao_result, pixel, vec4(clamp(visibility / float(SLICE_COUNT), 0.0, 1.0)));
}
